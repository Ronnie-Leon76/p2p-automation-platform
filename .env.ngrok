# Environment Configuration for ngrok Tunnel
# Copy this to .env.local when using ngrok

# Ngrok URL Configuration
NEXTAUTH_URL=https://working-ghoul-holy.ngrok-free.app
NEXT_PUBLIC_APP_URL=https://working-ghoul-holy.ngrok-free.app
NEXT_PUBLIC_ENVIRONMENT=ngrok

# Supabase Configuration for ngrok
# IMPORTANT: These need to be accessible from external clients
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOEoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Note: For database to work through ngrok, you have two options:
# Option 1: Use Supabase cloud (recommended for external access)
# Option 2: Set up ngrok tunnel for your local Supabase (port 55321)

# OKX API Configuration (same as local)
OKX_API_KEY=your_okx_api_key
OKX_SECRET_KEY=your_okx_secret_key
OKX_PASSPHRASE=your_okx_passphrase
OKX_API_URL=https://www.okx.com

# NextAuth Secret
NEXTAUTH_SECRET=your_nextauth_secret_key
