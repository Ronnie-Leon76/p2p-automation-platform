# Mock Data Development Environment
# Use this configuration for rapid UI development without external dependencies

# Environment Configuration
NEXT_PUBLIC_ENVIRONMENT=mock
NEXT_PUBLIC_USE_MOCK_DATA=true

# Development Features
NEXT_PUBLIC_SHOW_ENV_DEBUG=true

# NextAuth Configuration (optional for mock mode)
NEXTAUTH_SECRET="9Ob9zBtjbbEgfaiH1bmQ/2Br5IqXbwujHTQPyaKwSFw="
NEXTAUTH_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Exchange APIs (optional for mock mode - will be simulated)
OKX_API_KEY=your_okx_api_key
OKX_API_SECRET=your_okx_api_secret
OKX_API_PASSPHRASE=your_okx_passphrase
OKX_API_DELAY=3000

BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

BYBIT_API_KEY=your_bybit_api_key
BYBIT_API_SECRET=your_bybit_api_secret

# Cloudinary Configuration (optional for mock mode)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# M-Pesa Integration (simulated in mock mode)
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=your_mpesa_shortcode
MPESA_PASSKEY=your_mpesa_passkey
